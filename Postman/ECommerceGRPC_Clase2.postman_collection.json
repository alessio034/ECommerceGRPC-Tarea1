                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve el usuario sin la clave\", () => {",
                  "  pm.expect(j.id).to.be.above(0);",
                  "  pm.expect(j.email).to.eql(pm.collectionVariables.get(\"registroEmail\"));",
                  "  pm.expect(j.nombreCompleto).to.eql(\"Ana Tarea\");",
                  "  pm.expect(j).to.not.have.property(\"clave\");",
                  "});",
                  "pm.test(\"Location apunta al GET por id\", () =>",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/v1/usuarios/\" + j.id + \"$\")));"
                ]
