    {
      "name": "6 · Tarea 1",
      "description": "Tarea 1: tres endpoints REST nuevos que responden desde gRPC. POST /api/v1/productos (Admin), POST /api/v1/usuarios/registro (sin token) y GET /api/v1/usuarios (Admin). Necesita los tokens de la carpeta 0. Tarda unos 35 s: espera a que se libere la política «escrituras».",
      "item": [
        {
          "name": "Crear producto (Admin) → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{productoNombre}}\",\n  \"descripcion\": \"Producto creado desde la Tarea 1\",\n  \"precio\": 129.99,\n  \"stock\": 15,\n  \"categoria\": \"Accesorios\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nombre único en cada corrida: el 409 se prueba repitiéndolo más abajo.",
                  "pm.collectionVariables.set(\"productoNombre\", \"Producto Tarea1 \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"devuelve el producto con id y precio decimal\", () => {",
                  "  pm.expect(j.id).to.be.above(0);",
                  "  pm.expect(j.nombre).to.eql(pm.collectionVariables.get(\"productoNombre\"));",
                  "  pm.expect(j.precio).to.eql(129.99);",
                  "});",
                  "pm.test(\"Location apunta al GET por id\", () =>",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/v1/productos/\" + j.id + \"$\")));",
                  "pm.collectionVariables.set(\"nuevoProductoId\", j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Producto creado se lee por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/{{nuevoProductoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "productos",
                "{{nuevoProductoId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 con el producto nuevo\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().nombre).to.eql(pm.collectionVariables.get(\"productoNombre\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto sin token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
