                  "pm.test(\"409 nombre repetido (AlreadyExists de gRPC)\", () => pm.response.to.have.status(409));",
                  "pm.test(\"trae el código gRPC original\", () => pm.expect(pm.response.json().codigoGrpc).to.eql(\"AlreadyExists\"));"
