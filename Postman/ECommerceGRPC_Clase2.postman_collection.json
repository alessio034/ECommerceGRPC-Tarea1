                "exec": [
                  "// La política «escrituras» admite 3 por usuario cada 30 s (PUT de stock + 201 + 400 ya van 3).",
                  "// Se espera 31 s para que esta cuarta escritura no responda 429.",
                  "setTimeout(() => {}, 31000);"
                ]
              }
