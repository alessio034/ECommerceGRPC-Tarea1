        {
          "name": "Crear producto con token de Cliente → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
