        {
          "name": "Quinta escritura seguida → 429 con Retry-After",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"descripcion\": \"Sin nombre y con precio 0\",\n  \"precio\": 0,\n  \"stock\": -1,\n  \"categoria\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Después del 409 queda 1 de 3 escrituras usada: se gastan las otras 2 y esta debe responder 429.",
                  "// Al terminar, espere 30 s antes de correr de nuevo la colección.",
                  "const r = { url: pm.variables.replaceIn(\"{{baseUrl}}/api/v1/productos\"), method: \"POST\",",
                  "  header: { \"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"tokenAdmin\") },",
                  "  body: { mode: \"raw\", raw: \"{}\" } };",
                  "pm.sendRequest(r, () => pm.sendRequest(r, () => {}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"429 Too Many Requests\", () => pm.response.to.have.status(429));",
                  "pm.test(\"trae el encabezado Retry-After\", () =>",
                  "  pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0));"
                ]
              }
            }
          ]
        }
